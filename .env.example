# Copy to .env.local for development. Never commit real secrets.

# Postgres connection (Phase 0). Use a local dev instance or a managed provider.
DATABASE_URL="postgresql://cleantech:cleantech@localhost:5432/cleantech_advisor?schema=public"

# Postcodes.io has no API key requirement (free, open, no auth) - kept here
# only so the base URL can be swapped for a self-hosted mirror if needed.
POSTCODES_IO_BASE_URL="https://api.postcodes.io"

# NESO Carbon Intensity API - free, open, no auth required as of last review.
CARBON_INTENSITY_BASE_URL="https://api.carbonintensity.org.uk"

# PVGIS (European Commission) - free, open, no auth required as of last review.
PVGIS_BASE_URL="https://re.jrc.ec.europa.eu/api"

# AI provider key - server-side only, NEVER exposed to the client bundle.
ANTHROPIC_API_KEY=""

# Feature flag: force adapters to use recorded fixtures instead of live calls.
# Useful for CI, demos and offline development.
USE_FIXTURE_DATA="false"
